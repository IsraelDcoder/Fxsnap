{
  "expo": {
    "name": "FXSnap",
    "slug": "mobile",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E3E1DB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fxsnap.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "FXSnap uses the camera so you can submit a trading chart for analysis.",
        "NSPhotoLibraryUsageDescription": "FXSnap uses your photo library so you can select a trading chart for analysis."
      }
    },
    "android": {
      "package": "com.fxsnap.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "fxsnap-retention"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34e68993-4970-4cd5-8804-4e9805ef6d8c"
      }
    },
    "owner": "eazy001kng1"
  }
}
